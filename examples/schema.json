{
  "version": 1,
  "title": "Research Desk",
  "subtitle": "Always-on AI agents: launches, papers, ops",
  "composer": true,
  "toolbar": [
    { "id": "digest", "label": "Run digest now", "type": "run_routine", "job": "Researcher Digest", "primary": true },
    { "id": "chat", "label": "Open chat", "type": "open_chat" }
  ],
  "widgets": [
    { "id": "snapshot", "type": "kpi", "title": "Last digest", "width": "full", "empty": "No digest has run yet." },
    {
      "id": "findings",
      "type": "list",
      "title": "Top findings",
      "width": "full",
      "buttons": [
        { "id": "genuine", "label": "Genuine", "type": "run_action", "script": "genuine" },
        { "id": "escalate", "label": "Escalate", "type": "send_prompt", "prompt": "Escalate this finding (email the owning team) and update Home." }
      ]
    },
    {
      "id": "triage",
      "type": "buttons",
      "title": "Triage",
      "width": "full",
      "buttons": [
        { "id": "review", "label": "Review", "type": "send_prompt", "prompt": "Review the findings currently on this dashboard and update Home when done." }
      ]
    },
    { "id": "themes", "type": "table", "title": "Themes this week", "empty": "Needs a full week of runs." },
    { "id": "volume", "type": "timeseries", "title": "Items per digest" },
    { "id": "gaps", "type": "alerts", "title": "Gaps and caveats" },
    { "id": "cites", "type": "sources", "title": "Sources", "width": "full" }
  ]
}
